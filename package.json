{
  "name": "capturedwell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run manifest && react-router dev",
    "build": "npm run manifest && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "manifest": "node --env-file-if-exists=.env scripts/fetch-manifest.mjs",
    "sync": "node --env-file-if-exists=.env scripts/sync-drive.mjs",
    "check:drive": "node --env-file-if-exists=.env scripts/check-drive.mjs",
    "dev:phone": "npm run manifest && react-router dev --host",
    "preview:phone": "node scripts/serve.mjs"
  },
  "dependencies": {
    "isbot": "^5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.7",
    "puppeteer-core": "^25.11.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
