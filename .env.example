# Oblik lokalnih setup vrijednosti. NE upisuj ključeve ovdje.
#
# Ovaj fajl SE COMMITA u git i služi samo kao popis imena. Prave vrijednosti
# idu u `.env`, koji je gitignoran (.gitignore:69). Napravi ga naredbom:
#
#   cp .env.example .env
#
# Odakle koja vrijednost dolazi piše u docs/plan-drive-sync.md, sekcije A2–A4.

# Lokalno: apsolutni put do service account JSON ključa (A2/6).
# U CI-ju: GOOGLE_SERVICE_ACCOUNT_JSON nosi sadržaj fajla umjesto puta.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Id podijeljenog `capturedwell` foldera na Driveu (A3/4).
DRIVE_ROOT_FOLDER_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=capturedwell-media

VITE_MEDIA_BASE=https://img.capturedwell.com
